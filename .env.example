# ── Frontend (Next.js) ────────────────────────────────────
# Supabase (public keys only — safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

