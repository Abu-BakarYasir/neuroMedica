# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
venv/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files (can opt-in for committing if needed)
.env*.local
.env
.env.local
backend/.env

# Keep .env.example files (they contain no secrets)
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
backend/venv/

# claude code tooling
.claude/
.claude-flow/
.swarm/
.mcp.json

# Qdrant embedded mode local data
backend/qdrant_local_data/

# ML model artifacts — large/locally-derived caches
backend/models/*.h5
backend/models/*.pkl
backend/models/*.packed.keras
/neuroMedica_ecg_model.keras

# Local screenshots from browser tests
/chat-*.png
/rag-*.png
/verify-ecg-*.png
/ecg-new-model-*.png
