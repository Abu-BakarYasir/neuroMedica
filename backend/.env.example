# ── Required ──────────────────────────────────────────────
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── RAG / Retrieval ──────────────────────────────────────
QDRANT_URL=          # Qdrant Cloud URL (e.g. https://xxx.cloud.qdrant.io:6333)
QDRANT_API_KEY=      # Qdrant Cloud API key

# ── Generation ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Knowledge Graph (optional until Phase 3) ─────────────
NEO4J_URI=           # Neo4j Aura (e.g. neo4j+s://xxx.databases.neo4j.io)
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── CORS ─────────────────────────────────────────────────
# Comma-separated origins. Set to your Railway frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# ── Optional ─────────────────────────────────────────────
PUBMED_API_KEY=
DEBUG=false
